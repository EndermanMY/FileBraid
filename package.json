{
  "name": "filebraid",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build:engine": "cargo build --release --locked --manifest-path engine/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --base=./",
    "test": "node --test desktop/*.test.cjs",
    "start": "npm run build:engine && npm run build && electron ."
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^42.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
